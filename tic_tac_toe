// Tic-Tac-Toe Game
// Two-player console game in C++ with win/draw detection and input validation.

#include <iostream>
#include <limits>
using namespace std;

char board[3][3];

void resetBoard() {
    char c = '1';
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            board[i][j] = c++;
}

void printBoard() {
    cout << "\n";
    for (int i = 0; i < 3; i++) {
        cout << " " << board[i][0] << " | " << board[i][1] << " | " << board[i][2] << "\n";
        if (i < 2) cout << "---+---+---\n";
    }
    cout << "\n";
}

bool isWinner(char p) {
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == p && board[i][1] == p && board[i][2] == p) return true; // row
        if (board[0][i] == p && board[1][i] == p && board[2][i] == p) return true; // column
    }
    if (board[0][0] == p && board[1][1] == p && board[2][2] == p) return true;
    if (board[0][2] == p && board[1][1] == p && board[2][0] == p) return true;
    return false;
}

bool isDraw() {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (board[i][j] != 'X' && board[i][j] != 'O') return false;
    return true;
}

// Reads a valid, unoccupied cell (1-9) from the player and places the mark.
void makeMove(char player) {
    while (true) {
        int cell;
        cout << "Player " << player << ", choose a cell (1-9): ";
        if (!(cin >> cell)) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input. Enter a number from 1 to 9.\n";
            continue;
        }
        if (cell < 1 || cell > 9) {
            cout << "Out of range. Enter a number from 1 to 9.\n";
            continue;
        }
        int r = (cell - 1) / 3, c = (cell - 1) % 3;
        if (board[r][c] == 'X' || board[r][c] == 'O') {
            cout << "That cell is already taken. Try another.\n";
            continue;
        }
        board[r][c] = player;
        return;
    }
}

int main() {
    char again;
    do {
        resetBoard();
        char player = 'X';
        while (true) {
            printBoard();
            makeMove(player);
            if (isWinner(player)) {
                printBoard();
                cout << "Player " << player << " wins!\n";
                break;
            }
            if (isDraw()) {
                printBoard();
                cout << "It's a draw!\n";
                break;
            }
            player = (player == 'X') ? 'O' : 'X';
        }
        cout << "Play again? (y/n): ";
        cin >> again;
    } while (again == 'y' || again == 'Y');
    cout << "Thanks for playing!\n";
    return 0;
}
